REDIS_VERSION=7-alpine
KAFKA_VERSION=3.9.0
ROCKETMQ_VERSION=5.3.1

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ROCKETMQ_ENABLED=true
ROCKETMQ_NAME_SERVER=localhost:9876
SETTLEMENT_STRATEGY=KAFKA_STREAMS
DLQ_ENABLED=true
DLQ_MAX_RETRIES=3
DLQ_MONITORING_ENABLED=true
DLQ_ALERT_ENABLED=false

# OpenTelemetry
OTEL_SERVICE_NAME=bet-settlement-service
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Observability endpoints (used by otel-collector config)
JAEGER_ENDPOINT=jaeger:4317
PROMETHEUS_ENDPOINT=http://prometheus:9090/api/v1/write
